# Production Environment Variables
NODE_ENV=production
PORT=3000

# Google Gemini AI API Key (Lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Domain URL của web sau khi deploy (Dùng cho tính năng tự ping chống sleep 24/7)
# Ví dụ trên Render: https://scamguard-vn.onrender.com
# Hoặc trên Koyeb: https://scamguard-vn.koyeb.app
APP_URL=https://your-deployed-domain.com
